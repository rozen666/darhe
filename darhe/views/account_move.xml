<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

       <record id="account_move_inherit_add_state_payment_tree" model="ir.ui.view">
            <field name="name">account.move.inherit.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">               
                    <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" optional="show" />
                    <field name="number_of_document" />
                    <field name="invoice_debt" />
                </xpath>
                
            </field>
        </record>

        <record id="account_move_inherit_tree" model="ir.ui.view">
            <field name="name">account.move.inherit.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">               
                    <field name="number_of_document" />
                    <field name="invoice_debt" />
                </xpath>
                
            </field>
        </record>

        <record id="account_move_inherit_add_state_payment_form" model="ir.ui.view">
            <field name="name">account.move.inherit.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='journal_div']" position="after">              
                    <field name="number_of_document" />
                    <field name="invoice_debt" />
                </xpath>        
            </field>
        </record>

    </data>
</odoo>
